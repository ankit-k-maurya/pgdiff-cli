{
  "name": "@pgdiff/core",
  "version": "0.1.0",
  "description": "Schema introspection, diffing and migration planning for PostgreSQL.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./introspect": {
      "types": "./dist/introspect.d.ts",
      "default": "./dist/introspect.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -p tsconfig.test.json && node --test \".tsbuild/test/*.test.js\""
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
